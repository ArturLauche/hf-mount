{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the hf-mount window may do: its own commands plus only the plugin calls the UI uses.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://huggingface.co/*" },
        { "url": "https://winfsp.dev/*" },
        { "url": "https://github.com/winfsp/*" }
      ]
    }
  ]
}
