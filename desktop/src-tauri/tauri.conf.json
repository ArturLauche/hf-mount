{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hf-mount Desktop",
  "mainBinaryName": "hf-mount-desktop",
  "version": "0.13.1",
  "identifier": "co.huggingface.hf-mount",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hf-mount",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "hf-mount contributors",
    "copyright": "Apache-2.0. WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos.",
    "category": "Utility",
    "shortDescription": "Hugging Face repositories and buckets as Windows drives",
    "longDescription": "Mount Hugging Face models, datasets and storage buckets as native Windows drive letters. Files are fetched on demand.",
    "homepage": "https://github.com/huggingface/hf-mount",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hf-mount"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "resources": {
      "../../licenses/WinFsp-License.txt": "licenses/WinFsp-License.txt",
      "../../LICENSE": "licenses/hf-mount-LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {}
}
